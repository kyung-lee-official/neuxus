# Copy to .env at the repo root — Bun API (+ Prisma) and Next.js.

# Bun/Prisma DB (create DB e.g. neuxus)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/neuxus

# Prisma CLI: from apps/api → bun run prisma / prisma:generate
# (scripts pass --env-file=../../.env)

# Chat (MiniMax) — ask-mode synthesis
# Key from https://platform.minimaxi.com — use api.minimaxi.com (not api.minimax.io)
MINIMAX_API_KEY=
# Bun synthesis model. Default MiniMax-M3 if unset.
SYNTHESIS_MODEL=MiniMax-M3
# Anthropic-compatible base (see platform.minimaxi.com docs)
# MINIMAX_API_BASE_URL=https://api.minimaxi.com/anthropic
# SYNTHESIS_MAX_TOKENS=4096
# PORT=3001

# Next.js (apps/web) → Bun API — put in apps/web/.env.local to override
# NEXT_PUBLIC_API_URL=http://localhost:3001
# API_URL=http://localhost:3001
