# apps/web — Next.js. Copy to apps/web/.env.local.

# neuxus core (knowledge base, model providers, core logs/settings)
NEXT_PUBLIC_API_URL=http://localhost:3001
API_URL=http://localhost:3001

# neuxus chat (users, sessions, personal memory, chat)
NEXT_PUBLIC_CHAT_API_URL=http://localhost:3002
CHAT_API_URL=http://localhost:3002
