# apps/api-chat — stateful chat adapter. Copy to apps/api-chat/.env.

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/neuxus-chat
PORT=3002

# neuxus API (required for /query)
NEUXUS_API_URL=http://localhost:3001
NEUXUS_SERVICE_TOKEN=supersecret

# Agent settings (DeepSeek key and budgets) are stored in `agent_settings`
# and configured by an admin at /chat/settings/<admin-user>.
