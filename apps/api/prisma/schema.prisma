// Neuxus Postgres schema (`DATABASE_URL`, database name `neuxus`).
// Apply yourself, e.g. from apps/api:
//   bun run prisma -- migrate dev --name init
// Do not run migrate / db push from the agent.

generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model User {
    id        String   @id
    apiKey    String   @unique @map("api_key")
    /// `admin` | `member` — haewon (seed) or first created account is admin.
    role      String   @default("member")
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

    memories Memory[]
    sessions Session[]

    @@map("app_users")
}

model Memory {
    id        BigInt   @id @default(autoincrement())
    userId    String   @map("user_id")
    slug      String
    content   String
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, slug])
    @@index([userId, createdAt(sort: Desc)], map: "app_memories_user_id_idx")
    @@map("app_memories")
}

model Session {
    id        String   @id @default(uuid()) @db.Uuid
    userId    String   @map("user_id")
    title     String?
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

    user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    messages Message[]

    @@map("app_sessions")
}

/// Stored as TEXT with CHECK (role IN ('user', 'assistant')) — matches existing schema.
model Message {
    id        BigInt   @id @default(autoincrement())
    sessionId String   @map("session_id") @db.Uuid
    role      String
    content   String
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

    session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

    @@index([sessionId, createdAt], map: "app_messages_session_id_idx")
    @@map("app_messages")
}

/// Knowledge base (`kb_knowledge_bases`). All content and searches are scoped
/// to one knowledge base. `writable` false = read-only (corpus-backed,
/// ingest-written); true = updated directly.
model KnowledgeBase {
    id        String   @id
    name      String
    writable  Boolean  @default(false)
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

    pages            KnowledgePage[]
    corpusSettings   KnowledgeCorpusSettings?
    chunkSettings    KnowledgeChunkSettings?
    retrieveSettings KnowledgeRetrieveSettings?

    @@map("kb_knowledge_bases")
}

/// Corpus git remote (`kb_corpus_settings`), one row per knowledge base.
/// Nullable columns — app defaults live in code. `repo_url` null means no remote.
model KnowledgeCorpusSettings {
    knowledgeBaseId String @id @map("knowledge_base_id")

    repoUrl       String? @map("repo_url")
    branch        String?
    docsRoot      String? @map("docs_root")
    lastSyncedSha String? @map("last_synced_sha")

    knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

    @@map("kb_corpus_settings")
}

/// Chunkify knobs (`kb_chunk_settings`), one row per knowledge base. Nullable
/// columns — app defaults live in code (`CHUNKIFY_DEFAULTS`).
model KnowledgeChunkSettings {
    knowledgeBaseId String @id @map("knowledge_base_id")

    childTargetTokens       Int?    @map("child_target_tokens")
    childHardMaxTokens      Int?    @map("child_hard_max_tokens")
    childOverlapTokens      Int?    @map("child_overlap_tokens")
    childCrumbMinTokens     Int?    @map("child_crumb_min_tokens")
    parentMaxTokens         Int?    @map("parent_max_tokens")
    fenceIntroGlueMaxTokens Int?    @map("fence_intro_glue_max_tokens")
    tokenizerEncoding       String? @map("tokenizer_encoding")

    knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

    @@map("kb_chunk_settings")
}

/// Retrieval knobs (`kb_retrieve_settings`), one row per knowledge base.
/// Nullable columns — app defaults live in code (`RETRIEVE_DEFAULTS`).
model KnowledgeRetrieveSettings {
    knowledgeBaseId String @id @map("knowledge_base_id")

    /// Top-K child hits from the vector distance scan.
    childLimit    Int? @map("child_limit")
    /// Max unique parent ids returned after dedup.
    maxParents    Int? @map("max_parents")
    /// Cap on total parent-text characters.
    maxCharacters Int? @map("max_characters")

    knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

    @@map("kb_retrieve_settings")
}

/// Knowledge page (`kb_pages`). `body` is ingest-normalized. Identity is
/// `(knowledge_base_id, id)`.
model KnowledgePage {
    knowledgeBaseId String   @map("knowledge_base_id")
    id              String
    title           String
    tags            String[] @default([])
    body            String
    sourcePath      String?  @map("source_path")
    contentHash     String   @map("content_hash")
    metaHash        String?  @map("meta_hash")
    updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

    knowledgeBase     KnowledgeBase              @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
    parents           KnowledgeParent[]
    children          KnowledgeChild[]
    imageDescriptions KnowledgeImageDescription[]

    @@id([knowledgeBaseId, id])
    @@map("kb_pages")
}

model KnowledgeParent {
    knowledgeBaseId String @map("knowledge_base_id")
    id              String
    pageId          String @map("page_id")
    parentIndex     Int    @map("parent_index")
    text            String
    /// `kb_pages.content_hash` this tree was built from.
    sourcePageHash  String @map("source_page_hash")

    page          KnowledgePage   @relation(fields: [knowledgeBaseId, pageId], references: [knowledgeBaseId, id], onDelete: Cascade)
    children      KnowledgeChild[]

    @@id([knowledgeBaseId, id])
    @@unique([knowledgeBaseId, pageId, parentIndex])
    @@map("kb_parents")
}

/// `embedding` is pgvector; set dimensions (e.g. vector(768)) in the migration.
/// No HNSW index by default.
model KnowledgeChild {
    knowledgeBaseId String                      @map("knowledge_base_id")
    id              String
    parentId        String                      @map("parent_id")
    pageId          String                      @map("page_id")
    childIndex      Int                         @map("child_index")
    text            String
    embedding       Unsupported("vector")?
    embeddingModel  String?                     @map("embedding_model")
    embeddedAt      DateTime?                   @map("embedded_at") @db.Timestamptz(6)

    parent        KnowledgeParent @relation(fields: [knowledgeBaseId, parentId], references: [knowledgeBaseId, id], onDelete: Cascade)
    page          KnowledgePage   @relation(fields: [knowledgeBaseId, pageId], references: [knowledgeBaseId, id], onDelete: Cascade)

    @@id([knowledgeBaseId, id])
    @@unique([knowledgeBaseId, parentId, childIndex])
    @@map("kb_children")
}

/// Per-image description cache (`kb_image_descriptions`), one row per
/// `(knowledge_base_id, page_id, image_path)`. Read-only knowledge bases only.
model KnowledgeImageDescription {
    knowledgeBaseId   String    @map("knowledge_base_id")
    pageId            String    @map("page_id")
    /// Path of the image as written inside the markdown body.
    imagePath         String    @map("image_path")
    /// sha256 hex of the image bytes. Compared to a fresh hash to decide skip vs re-describe.
    imageContentHash  String    @map("image_content_hash")
    /// `ignore` | `manual` | `vision-captioning`.
    policy            String
    description       String?
    captionModel      String?   @map("caption_model")
    captionPromptHash String?   @map("caption_prompt_hash")
    descriptionHash   String?   @map("description_hash")
    embedding         Unsupported("vector")?
    embeddingModel    String?   @map("embedding_model")
    embeddedAt        DateTime? @map("embedded_at") @db.Timestamptz(6)

    page          KnowledgePage @relation(fields: [knowledgeBaseId, pageId], references: [knowledgeBaseId, id], onDelete: Cascade)

    @@id([knowledgeBaseId, pageId, imagePath])
    @@map("kb_image_descriptions")
}

/// Model provider configuration (`app_model_provider_config`). Single row, id =
/// `"default"`. Stores only raw per-provider connection overrides; the
/// app-level task→model assignment lives in `app_model_task_config`.
model AppModelProviderConfig {
    id String @id @default("default")

    /// Per-provider connection settings, keyed by catalog `providerId`.
    providerConnections Json? @map("provider_connections")

    @@map("app_model_provider_config")
}

/// App-level task→model assignment (`app_model_task_config`). Single row,
/// id = `"default"`. Maps each app task (`embedding`, `text-synthesis`,
/// `md-image-captioning`) to a catalog `modelId` (or null). Kept apart from
/// `app_model_provider_config`
/// because it is application wiring, not provider info; task definitions and
/// their required capability live in code, not the DB.
model AppModelTaskConfig {
    id String @id @default("default")

    /// Task → catalog `modelId` (or null). Keys: `embedding`, `text-synthesis`, `md-image-captioning`.
    tasks Json?

    @@map("app_model_task_config")
}

/// Generic structured app log row (`app_log`). One row per logixlysia
/// record. `meta` carries logixlysia's `time` / `pid` / `hostname` /
/// context tree / any app bindings. `level`, `msg`, and `name` are
/// top-level for cheap filtering. No FK to `app_users` — the logger
/// must never block a request on referential checks.
model AppLog {
    id        BigInt   @id @default(autoincrement())
    /// `trace` | `debug` | `info` | `warn` | `error` | `fatal`
    level     String
    msg       String
    /// logixlysia child logger name (e.g. `"synthesis"`, `"auth"`). Null for root.
    name      String?
    /// Full logixlysia record minus the columns above (time, pid, hostname, bindings, …).
    meta      Json
    /// Optional owner. Set only by the retrieve and synthesis domains; other
    /// loggers leave it null. No FK — the logger must never block a request
    /// on referential checks.
    userId    String?  @map("user_id")
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

    @@index([createdAt(sort: Desc)], map: "app_log_created_at_idx")
    @@index([level, createdAt(sort: Desc)], map: "app_log_level_created_at_idx")
    @@index([name, createdAt(sort: Desc)], map: "app_log_name_created_at_idx")
    @@index([userId, createdAt(sort: Desc)], map: "app_log_user_id_created_at_idx")
    @@map("app_log")
}

/// Logger runtime config (`app_log_settings`). Nullable columns — app
/// defaults live in code (`LOG_DEFAULTS`), not SQL DEFAULT. Single row:
/// id = `"default"`. Mirrors the other single-row config tables.
model AppLogSettings {
    id String @id @default("default")

    /// Sinks: any combination of `console` and `postgres`. Empty array
    /// (`@default([])`) means "use app defaults".
    sinks           String[] @default([])
    /// Bounded queue capacity for the postgres sink. `null` falls back.
    queueSize       Int?     @map("queue_size")
    /// Drain budget (ms) for the worker on shutdown / `flushLogs()`.
    drainTimeoutMs  Int?     @map("drain_timeout_ms")
    /// Pretty-print logixlysia's stdout via pino-pretty. `null` falls back.
    pretty          Boolean?

    @@map("app_log_settings")
}
