{
  "name": "neuxus",
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/bun": "latest",
    "lefthook": "^2.1.10",
    "turbo": "^2.5.4"
  },
  "packageManager": "bun@1.3.12",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@neuxus/api",
    "dev:web": "turbo run dev --filter=@neuxus/web",
    "seed": "bun --env-file=.env run --filter @neuxus/api seed",
    "check-types": "turbo run check-types"
  },
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/*"
  ]
}
