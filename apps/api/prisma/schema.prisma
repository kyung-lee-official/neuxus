// Neuxus Postgres schema (`DATABASE_URL`, database name `neuxus`).
// Apply yourself, e.g. from apps/api:
//   bun run prisma -- migrate dev --name init
// Do not run migrate / db push from the agent.

generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model User {
    id        String   @id
    apiKey    String   @unique @map("api_key")
    /// `admin` | `member` — haewon (seed) or first created account is admin.
    role      String   @default("member")
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

    memories Memory[]
    sessions Session[]

    @@map("app_users")
}

model Memory {
    id        BigInt   @id @default(autoincrement())
    userId    String   @map("user_id")
    slug      String
    content   String
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, slug])
    @@index([userId, createdAt(sort: Desc)], map: "app_memories_user_id_idx")
    @@map("app_memories")
}

model Session {
    id        String   @id @default(uuid()) @db.Uuid
    userId    String   @map("user_id")
    title     String?
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

    user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    messages Message[]

    @@map("app_sessions")
}

/// Stored as TEXT with CHECK (role IN ('user', 'assistant')) — matches existing schema.
model Message {
    id        BigInt   @id @default(autoincrement())
    sessionId String   @map("session_id") @db.Uuid
    role      String
    content   String
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

    session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

    @@index([sessionId, createdAt], map: "app_messages_session_id_idx")
    @@map("app_messages")
}

/// Corpus git remote (`kb_corpus_settings`). Nullable columns — app defaults
/// live in code, not SQL DEFAULT. Single row: id = `"default"`.
/// `repo_url` null means no remote (do not clone).
model KnowledgeCorpusSettings {
    id String @id @default("default")

    repoUrl       String? @map("repo_url")
    branch        String?
    docsRoot      String? @map("docs_root")
    lastSyncedSha String? @map("last_synced_sha")

    @@map("kb_corpus_settings")
}

/// Chunkify knobs (`kb_chunk_settings`). Nullable columns — app defaults live in code
/// (`CHUNKIFY_DEFAULTS`), not SQL DEFAULT. Single row: id = `"default"`.
model KnowledgeChunkSettings {
    id String @id @default("default")

    childTargetTokens       Int?    @map("child_target_tokens")
    childHardMaxTokens      Int?    @map("child_hard_max_tokens")
    childOverlapTokens      Int?    @map("child_overlap_tokens")
    childCrumbMinTokens     Int?    @map("child_crumb_min_tokens")
    parentMaxTokens         Int?    @map("parent_max_tokens")
    fenceIntroGlueMaxTokens Int?    @map("fence_intro_glue_max_tokens")
    tokenizerEncoding       String? @map("tokenizer_encoding")

    @@map("kb_chunk_settings")
}

/// Retrieval knobs (`kb_retrieve_settings`). Nullable columns — app defaults
/// live in code (`RETRIEVE_DEFAULTS`), not SQL DEFAULT. Single row: id =
/// `"default"`. Mirrors the other single-row config tables.
model KnowledgeRetrieveSettings {
    id String @id @default("default")

    /// Top-K child hits from the vector distance scan.
    childLimit     Int? @map("child_limit")
    /// Max unique parent ids returned after dedup.
    maxParents     Int? @map("max_parents")
    /// Cap on total parent-text characters.
    maxCharacters  Int? @map("max_characters")

    @@map("kb_retrieve_settings")
}

/// Per-image description cache (`kb_image_descriptions`). One row per
/// (page, image) pair. The hash is the freshness marker; the description
/// is what the enricher stored the last time it fetched one for these
/// exact image bytes.
model KnowledgeImageDescription {
    pageId      String   @map("page_id")
    /// Path of the image as written inside the markdown body (relative
    /// to the source file's directory). Combined with `pageId` this is
    /// the unique key.
    imagePath   String   @map("image_path")
    /// sha256 hex of the image file's bytes. Compared to a fresh hash
    /// of the image to decide "skip vs re-describe".
    contentHash String   @map("content_hash")
    /// LLM-generated description (single-line content, matching the
    /// `<!-- image_desc: ... -->` lexer rule).
    description String
    createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt   DateTime @updatedAt          @map("updated_at") @db.Timestamptz(6)

    page KnowledgePage @relation(fields: [pageId], references: [id], onDelete: Cascade)

    @@id([pageId, imagePath])
    @@map("kb_image_descriptions")
}

/// Model registry configuration (`app_model_config`). Single row, id =
/// `"default"`. Three task slots — `embedding`, `llm`, `vision` — each
/// independent (no inheritance). Each slot picks one model id from the
/// in-code `MODELS` catalog; per-slot `apiKey` / `baseUrl` / `port`
/// overrides the provider defaults. The catalog (not this row) owns the
/// wire format, headers, context window, and capability flags.
model AppModelConfig {
    id String @id @default("default")

    /// Embedding task slot. Shape:
    /// `{ modelId: string, apiKey?: string, baseUrl?: string, port?: number }`.
    /// Null until the user configures a model.
    embedding Json?
    /// LLM task slot. Same shape as `embedding`.
    llm       Json?
    /// Vision (image description) task slot. Same shape as `embedding`.
    vision    Json?

    @@map("app_model_config")
}

/// Knowledge page (`kb_pages`). `body` is ingest-normalized. Apply via your own migrate.
model KnowledgePage {
    id          String   @id
    slug        String   @unique
    title       String
    type        String?
    tags        String[] @default([])
    body        String
    sourcePath  String?  @map("source_path")
    contentHash String   @map("content_hash")
    updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

    parents  KnowledgeParent[]
    children KnowledgeChild[]
    imageDescriptions KnowledgeImageDescription[]

    @@map("kb_pages")
}

model KnowledgeParent {
    id          String @id
    pageId      String @map("page_id")
    parentIndex Int    @map("parent_index")
    text        String
    startOffset Int?   @map("start_offset")
    endOffset   Int?   @map("end_offset")

    page     KnowledgePage    @relation(fields: [pageId], references: [id], onDelete: Cascade)
    children KnowledgeChild[]

    @@unique([pageId, parentIndex])
    @@map("kb_parents")
}

/// `embedding` is pgvector; set dimensions (e.g. vector(768)) in the migration. HNSW is not in this schema.
model KnowledgeChild {
    id             String                      @id
    parentId       String                      @map("parent_id")
    pageId         String                      @map("page_id")
    childIndex     Int                         @map("child_index")
    text           String
    startOffset    Int?                        @map("start_offset")
    endOffset      Int?                        @map("end_offset")
    embedding      Unsupported("vector")?
    embeddingModel String?                     @map("embedding_model")
    embeddedAt     DateTime?                   @map("embedded_at") @db.Timestamptz(6)

    parent KnowledgeParent @relation(fields: [parentId], references: [id], onDelete: Cascade)
    page   KnowledgePage   @relation(fields: [pageId], references: [id], onDelete: Cascade)

    @@unique([parentId, childIndex])
    @@map("kb_children")
}

/// Generic structured app log row (`app_log`). One row per logixlysia
/// record. `meta` carries logixlysia's `time` / `pid` / `hostname` /
/// context tree / any app bindings. `level`, `msg`, and `name` are
/// top-level for cheap filtering. No FK to `app_users` — the logger
/// must never block a request on referential checks.
model AppLog {
    id        BigInt   @id @default(autoincrement())
    /// `trace` | `debug` | `info` | `warn` | `error` | `fatal`
    level     String
    msg       String
    /// logixlysia child logger name (e.g. `"synthesis"`, `"auth"`). Null for root.
    name      String?
    /// Full logixlysia record minus the columns above (time, pid, hostname, bindings, …).
    meta      Json
    /// Optional owner. Set only by the retrieve and synthesis domains; other
    /// loggers leave it null. No FK — the logger must never block a request
    /// on referential checks.
    userId    String?  @map("user_id")
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

    @@index([createdAt(sort: Desc)], map: "app_log_created_at_idx")
    @@index([level, createdAt(sort: Desc)], map: "app_log_level_created_at_idx")
    @@index([name, createdAt(sort: Desc)], map: "app_log_name_created_at_idx")
    @@index([userId, createdAt(sort: Desc)], map: "app_log_user_id_created_at_idx")
    @@map("app_log")
}

/// Logger runtime config (`app_log_settings`). Nullable columns — app
/// defaults live in code (`LOG_DEFAULTS`), not SQL DEFAULT. Single row:
/// id = `"default"`. Mirrors the other single-row config tables.
model AppLogSettings {
    id String @id @default("default")

    /// Sinks: any combination of `console` and `postgres`. Empty array
    /// (`@default([])`) means "use app defaults".
    sinks           String[] @default([])
    /// Bounded queue capacity for the postgres sink. `null` falls back.
    queueSize       Int?     @map("queue_size")
    /// Drain budget (ms) for the worker on shutdown / `flushLogs()`.
    drainTimeoutMs  Int?     @map("drain_timeout_ms")
    /// Pretty-print logixlysia's stdout via pino-pretty. `null` falls back.
    pretty          Boolean?

    @@map("app_log_settings")
}
